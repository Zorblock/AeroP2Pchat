export component MainWindow inherits Window {
    title: "Aero P2P Chat Online Installer";
    icon: @image-url("../../assets/app-150.png");
    width: 600px;
    height: 270px;

    in-out property <string> status: "Ready to install Aero P2P Chat";
    in-out property <string> detail: "Click Install to download the newest version from GitHub.";
    in-out property <string> version: "The newest version will be checked after you continue.";
    in-out property <string> security-note: "Each download is checked against its GitHub SHA-256 checksum.";
    in-out property <float> progress: 0;
    in-out property <string> button-text: "Install";
    in-out property <bool> can-install: true;
    in-out property <bool> show-install: true;
    in-out property <bool> show-switch-action: false;
    in-out property <bool> show-maintenance-actions: false;
    in-out property <bool> show-security-note: true;
    in-out property <bool> show-progress: false;
    in-out property <bool> show-uninstall-confirmation: false;
    in-out property <bool> show-close-app-action: false;
    in-out property <color> window-color: #f5f5f5;
    in-out property <color> surface-color: #ffffff;
    in-out property <color> border-color: #dedede;
    in-out property <color> text-color: #1b1b1b;
    in-out property <color> muted-color: #616161;
    in-out property <color> accent-color: #0078d4;
    in-out property <color> accent-pressed-color: #005a9e;
    in-out property <color> accent-text-color: #ffffff;
    in-out property <color> disabled-color: #c8c8c8;
    in-out property <color> repair-color: #e8f4fa;
    in-out property <color> repair-hover-color: #d8edf7;
    in-out property <color> repair-border-color: #8bc3da;
    in-out property <color> repair-text-color: #0d5474;
    in-out property <color> danger-color: #fff0f0;
    in-out property <color> danger-hover-color: #ffe2e2;
    in-out property <color> danger-border-color: #e3a2a2;
    in-out property <color> danger-text-color: #9d2727;
    callback install();
    callback switch-to-windows-setup();
    callback repair();
    callback uninstall();
    callback confirm-uninstall();
    callback cancel-uninstall();
    callback close-running-app();

    background: root.window-color;

    Rectangle {
        x: 28px;
        y: 28px;
        width: 544px;
        height: 214px;
        background: root.surface-color;
        border-color: root.border-color;
        border-width: 1px;
        border-radius: 13px;

        Text {
            x: 24px;
            y: 22px;
            width: 496px;
            height: 27px;
            text: root.status;
            color: root.text-color;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }

        Text {
            x: 24px;
            y: 54px;
            width: 496px;
            height: 33px;
            text: root.detail;
            color: root.muted-color;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: center;
        }

        Rectangle {
            x: 24px;
            y: 102px;
            width: 496px;
            height: 4px;
            background: root.border-color;
            clip: true;
            visible: root.show-progress;

            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width * root.progress;
                height: parent.height;
                background: root.accent-color;
            }
        }

        Text {
            x: 24px;
            y: 116px;
            width: 496px;
            height: 20px;
            text: root.version;
            color: root.muted-color;
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            x: 24px;
            y: 148px;
            width: root.show-switch-action ? 200px : 330px;
            height: 20px;
            text: root.security-note;
            color: root.muted-color;
            font-size: 11px;
            vertical-alignment: center;
            visible: root.show-security-note;
        }

        Rectangle {
            x: 168px;
            y: 150px;
            width: 104px;
            height: 36px;
            background: repair-area.has-hover ? root.repair-hover-color : root.repair-color;
            border-color: root.repair-border-color;
            border-width: 1px;
            border-radius: 9px;
            visible: root.show-maintenance-actions;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Repair";
                color: root.repair-text-color;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            repair-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.repair(); }
            }
        }

        Rectangle {
            x: 280px;
            y: 150px;
            width: 112px;
            height: 36px;
            background: uninstall-area.has-hover ? root.danger-hover-color : root.danger-color;
            border-color: root.danger-border-color;
            border-width: 1px;
            border-radius: 9px;
            visible: root.show-maintenance-actions;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Uninstall";
                color: root.danger-text-color;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            uninstall-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.uninstall(); }
            }
        }

        Rectangle {
            x: 300px;
            y: 150px;
            width: 92px;
            height: 36px;
            background: cancel-uninstall-area.has-hover ? root.border-color : transparent;
            border-color: root.border-color;
            border-width: 1px;
            border-radius: 9px;
            visible: root.show-uninstall-confirmation;

            Text {
                width: parent.width;
                height: parent.height;
                text: "No";
                color: root.text-color;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            cancel-uninstall-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.cancel-uninstall(); }
            }
        }

        Rectangle {
            x: 400px;
            y: 150px;
            width: 120px;
            height: 36px;
            background: confirm-uninstall-area.has-hover ? root.danger-hover-color : root.danger-color;
            border-color: root.danger-border-color;
            border-width: 1px;
            border-radius: 9px;
            visible: root.show-uninstall-confirmation;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Yes, uninstall";
                color: root.danger-text-color;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            confirm-uninstall-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.confirm-uninstall(); }
            }
        }

        Rectangle {
            x: 340px;
            y: 150px;
            width: 180px;
            height: 36px;
            background: close-app-area.pressed ? root.accent-pressed-color : root.accent-color;
            border-radius: 9px;
            visible: root.show-close-app-action;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Close Aero P2P Chat";
                color: root.accent-text-color;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            close-app-area := TouchArea {
                width: parent.width;
                height: parent.height;
                clicked => { root.close-running-app(); }
            }
        }

        Rectangle {
            x: 240px;
            y: 150px;
            width: 132px;
            height: 36px;
            background: switch-area.has-hover ? root.border-color : transparent;
            border-color: root.border-color;
            border-width: 1px;
            border-radius: 9px;
            visible: root.show-switch-action;

            Text {
                width: parent.width;
                height: parent.height;
                text: "Switch to setup";
                color: root.text-color;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            switch-area := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                clicked => { root.switch-to-windows-setup(); }
            }
        }

        Rectangle {
            x: root.show-maintenance-actions ? 400px : 388px;
            y: 150px;
            width: root.show-maintenance-actions ? 120px : 132px;
            height: 36px;
            background: !root.can-install ? root.disabled-color : install-area.pressed ? root.accent-pressed-color : root.accent-color;
            border-radius: 9px;
            visible: root.show-install;

            Text {
                width: parent.width;
                height: parent.height;
                text: root.button-text;
                color: root.accent-text-color;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            install-area := TouchArea {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                enabled: root.can-install;
                clicked => { root.install(); }
            }
        }
    }
}
